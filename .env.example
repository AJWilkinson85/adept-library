# Neon Postgres (pooled connection string is fine)
DATABASE_URL=

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=
# Canonical URL of this app (Auth.js reads AUTH_URL; NEXTAUTH_URL is accepted as an alias)
AUTH_URL=https://members.adeptadvisors.com
NEXTAUTH_URL=https://members.adeptadvisors.com

# Resend (magic-link emails). The from-address domain must be verified in Resend.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Adept Advisors <hello@adeptadvisors.com>"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the "Advisor on Call" monthly subscription (price_...)
STRIPE_PRICE_ADVISOR=

# Comma-separated emails that always have access and can use /admin
ADMIN_EMAILS=aaron@adeptadvisors.com

# Public site URL (used for absolute links in Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://members.adeptadvisors.com
